# Streamlit demo container. Calls the FraudShield API via FRAUDSHIELD_API_URL.
# Built separately from the API image so streamlit + matplotlib + plotly
# don't bloat the inference container.

FROM python:3.12-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
 && apt-get install --no-install-recommends -y libgomp1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --shell /usr/sbin/nologin --uid 1000 fraudshield

COPY requirements.txt requirements-notebook.txt ./
RUN pip install -r requirements.txt \
 && pip install streamlit==1.41.1 matplotlib==3.10.0 plotly==5.24.1

COPY pyproject.toml README.md ./
COPY src ./src
COPY app ./app
RUN pip install --no-deps . \
 && chown -R fraudshield:fraudshield /app

USER fraudshield

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; \
sys.exit(0 if urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=3).status==200 else 1)"

CMD ["streamlit", "run", "app/streamlit_app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
